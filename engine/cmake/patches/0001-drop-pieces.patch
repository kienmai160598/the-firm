+	void torrent::drop_pieces(std::vector<piece_index_t> const& pieces)
+	{
+		TORRENT_ASSERT(is_single_thread());
+		if (m_abort || !m_storage || !valid_metadata() || pieces.empty()) return;
+		if (m_state == torrent_status::checking_files
+			|| m_state == torrent_status::checking_resume_data)
+			return;
+
+		bool const was_finished = is_finished();
+		if (m_seed_mode) leave_seed_mode(seed_mode_t::skip_checking);
+		need_picker();
+
+		bool forgot_had_piece = false;
+		for (piece_index_t const piece : pieces)
+		{
+			if (piece < piece_index_t(0) || piece >= m_torrent_file->end_piece()) continue;
+			if (m_picker->have_piece(piece))
+			{
+				m_picker->we_dont_have(piece);
+				for (auto* p : m_connections)
+				{
+					TORRENT_INCREMENT(m_iterating_connections);
+					p->write_dont_have(piece);
+				}
+				forgot_had_piece = true;
+				m_ses.disk_thread().async_clear_piece(m_storage, piece
+					, [](piece_index_t const&) {});
+			}
+			else if (m_picker->is_downloading(piece) && !m_picker->is_piece_finished(piece))
+			{
+				// the same path a failed hash takes, without blaming any peer
+				m_picker->lock_piece(piece);
+				m_ses.disk_thread().async_clear_piece(m_storage, piece
+					, [self = shared_from_this()](piece_index_t const& p)
+					{ self->on_piece_sync(p, {}); });
+			}
+		}
+		m_ses.deferred_submit_jobs();
+		if (!forgot_had_piece) return;
+
+		m_have_all = false;
+		m_file_progress.clear();
+		m_file_progress.init(picker(), m_torrent_file->files());
+		update_gauge();
+		state_updated();
+		if (was_finished && !is_finished()) resume_download();
+	}
+
