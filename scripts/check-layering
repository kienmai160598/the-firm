#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
sources=apps/android-tv/app/src
source_sets=(main full box debug)
package_path=java/com/kien/movies

layer_paths() {
	local layer source_set
	for layer in "$@"; do
		for source_set in "${source_sets[@]}"; do
			echo ":(glob)$sources/$source_set/$package_path/$layer/**/*.kt"
		done
	done
}

references() {
	local package=$1
	shift
	git -C "$repo_root" grep --untracked -n -F "$package" -- $(layer_paths "$@") || true
}

violations=$(
	references com.kien.movies.ui. data core domain
	references com.kien.movies.data. domain
)

if [[ -n "$violations" ]]; then
	echo "layering: data, core and domain must not use ui; domain must not use data"
	echo "$violations"
	exit 1
fi
