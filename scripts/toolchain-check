#!/usr/bin/env bash
set -euo pipefail

repo_root=$(cd "$(dirname "$0")/.." && pwd)
builds=(shared apps/android-tv)
shared_versions=(agp kotlin sentry sentryGradle)

catalog_version() {
	local build=$1 key=$2
	awk -v key="$key" -F'"' '
		/^\[versions\]/ { inside = 1; next }
		/^\[/ { inside = 0 }
		inside && $1 ~ "^" key "[[:space:]]*=" { print $2; exit }
	' "$repo_root/$build/gradle/libs.versions.toml"
}

wrapper_distribution() {
	local build=$1
	sed -n 's/^distributionUrl=.*gradle-\(.*\)-bin.zip$/\1/p' \
		"$repo_root/$build/gradle/wrapper/gradle-wrapper.properties"
}

report_drift() {
	local name=$1 first=$2 second=$3
	[[ "$first" == "$second" ]] && return 0
	echo "toolchain drift: $name is '$first' in ${builds[0]} and '$second' in ${builds[1]}"
	return 1
}

drift=0
for key in "${shared_versions[@]}"; do
	report_drift "$key" "$(catalog_version "${builds[0]}" "$key")" \
		"$(catalog_version "${builds[1]}" "$key")" || drift=1
done
report_drift gradle "$(wrapper_distribution "${builds[0]}")" \
	"$(wrapper_distribution "${builds[1]}")" || drift=1

if [[ $drift -eq 0 ]]; then
	echo "toolchain: both Gradle builds agree"
fi
exit $drift
